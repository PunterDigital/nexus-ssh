{
  "name": "nexus-ssh",
  "version": "0.1.0",
  "description": "Nexus — a modern SSH terminal client",
  "main": "dist/main/index.js",
  "author": "Punter Digital Limited",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "rebuild": "npx @electron/rebuild --only @journeyapps/sqlcipher",
    "dev": "concurrently -k \"pnpm build:main --watch\" \"pnpm build:preload --watch\" \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/wait-for-vite.js && electron .",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outdir=dist/main --external:electron --external:ssh2 --external:@journeyapps/sqlcipher --external:basic-ftp --external:@aws-sdk/client-s3 --external:libsodium-wrappers-sumo --format=cjs --sourcemap",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --outdir=dist/main --external:electron --format=cjs --sourcemap",
    "build:renderer": "vite build",
    "package": "pnpm build && electron-builder",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "ssh2": "^1.16.0",
    "@journeyapps/sqlcipher": "^5.3.1",
    "electron-updater": "^6.3.0",
    "libsodium-wrappers-sumo": "^0.7.15",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "uuid": "^11.0.0",
    "basic-ftp": "^5.0.5",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "vitest": "^2.1.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0"
  }
}
