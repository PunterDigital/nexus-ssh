{
  "name": "nexus-ssh",
  "version": "0.2.0",
  "description": "Nexus — a modern SSH terminal client",
  "main": "dist/main/index.js",
  "author": "Punter Digital Limited",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "rebuild": "electron-rebuild -f --only @journeyapps/sqlcipher",
    "dev": "concurrently -k \"pnpm build:main --watch\" \"pnpm build:preload --watch\" \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/wait-for-vite.js && electron .",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outdir=dist/main --external:electron --external:ssh2 --external:@journeyapps/sqlcipher --external:basic-ftp --external:@aws-sdk/client-s3 --external:libsodium-wrappers-sumo --external:electron-updater --format=cjs --sourcemap",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --outdir=dist/main --external:electron --format=cjs --sourcemap",
    "build:renderer": "vite build",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "package": "pnpm build && electron-builder",
    "lint": "eslint src/ --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@journeyapps/sqlcipher": "^5.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "^6.2.3",
    "electron-updater": "^6.8.11",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "uuid": "^11.1.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PunterDigital/nexus-ssh.git"
  },
  "engines": {
    "node": ">=24"
  }
}
